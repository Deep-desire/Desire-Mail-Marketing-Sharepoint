# ── Database (Supabase PostgreSQL) ──
# Used for: Admin auth, Templates, Unsubscribed list, Campaign tracking
# Contacts are fetched from SharePoint via the Azure Function — NOT stored here
DATABASE_URL=postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ── JWT ──
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=24h

# ── Azure Communication Services Email ──
AZURE_CONNECTION_STRING=your-azure-communication-connection-string
AZURE_FROM_EMAIL=donotreply@your-domain.com

# ── Microsoft Graph (mail sending) ──
GRAPH_TENANT_ID=your-tenant-id
GRAPH_CLIENT_ID=your-app-client-id
GRAPH_CLIENT_SECRET=your-app-client-secret
GRAPH_SENDER_EMAIL=sender@yourtenant.onmicrosoft.com

# ── App ──
FRONTEND_URL=http://localhost:5173
APP_PORT=3000

# ── Microsoft SharePoint (Graph API — Client Credentials) ──
# Azure Portal → Azure Active Directory → Overview → Tenant ID
TENANT_ID=your-tenant-id

# Azure App Registration → Application (client) ID
SP_CLIENT_ID=your-client-id

# Azure App Registration → Certificates & Secrets → Client Secret Value
SP_CLIENT_SECRET=your-client-secret

# SharePoint Site ID  (format: hostname,siteCollectionId,webId)
# Find via: GET https://graph.microsoft.com/v1.0/sites/hostname:/
SP_SITE_ID=your-tenant.sharepoint.com,site-collection-id,web-id

# SharePoint List ID (GUID of the List containing contacts)
# Find via: GET https://graph.microsoft.com/v1.0/sites/{site-id}/lists
SP_LIST_ID=your-list-guid

# ── Email Scheduler & Throttling ──
# Number of emails to process in a single batch (default: 5)
BATCH_SIZE=5
# Minimum delay (in seconds) between individual email sends within a batch (default: 10)
EMAIL_DELAY_MIN_SEC=10
# Maximum delay (in seconds) between individual email sends within a batch (default: 15)
EMAIL_DELAY_MAX_SEC=15
# Delay (in seconds) after a batch completes before starting the next batch (default: 15)
BATCH_DELAY_SEC=15

# ── Azure Durable Functions Integration (campaign send orchestration) ──
# Deploy azure-email-function to an Azure Function App and specify its BASE URL & secret below
# (no route path — backend/src/index.js appends /api/orchestration/start-campaign itself).
AZURE_FUNCTION_URL=https://your-function-app.azurewebsites.net
AZURE_FUNCTION_SECRET_KEY=your_azure_function_secret_key_change_in_production

# ── Azure Function Integration (SharePoint list fetch) ──
# The sharepointFetchContacts function (azure-email-function/src/functions/sharepointFetchTrigger.js)
# pages through Graph API so large lists (10k+ items) don't hit Vercel's serverless timeout.
# If deployed to the SAME Function App as above, this can be identical to AZURE_FUNCTION_URL/KEY.
# Base URL only — backend/src/sharepoint.js appends /api/sharepoint/contacts itself.
AZURE_SHAREPOINT_FUNCTION_URL=https://your-function-app.azurewebsites.net
AZURE_SHAREPOINT_FUNCTION_SECRET_KEY=your_azure_function_secret_key_change_in_production

